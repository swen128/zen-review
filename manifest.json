{
  "manifest_version": 3,
  "name": "Zen Review",
  "version": "0.1.0",
  "description": "Collapses or hides test files and other noise on GitHub pull request diffs.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["settings.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
